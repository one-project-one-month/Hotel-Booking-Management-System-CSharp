@page "/admin/room"
@using HotelManagementSystem_Web.Layout.AdminLayout
@layout AdminLayout
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient _httpClient
@inject NavigationManager _navigation
@inject IJSRuntime JS

<h2 class="text-center my-4 text-danger">Room Management</h2>

<div class="container mb-4">
    <div class="row gx-2 align-items-center">
        <div class="col-auto">
            <input class="form-control"
                   placeholder="Room No"
                   value="@filter.RoomNo"
                   @oninput="OnRoomNoInput" />
        </div>

        <div class="col-auto">
            <InputSelect TValue="Guid?" class="form-select"
                         Value="@filter.RoomTypeId"
                         ValueChanged="OnRoomTypeChanged"
                         ValueExpression="@(() => filter.RoomTypeId)">
                <option value="">All Types</option>
                @foreach (var rt in roomTypes)
                {
                    <option value="@rt.RoomTypeId">@rt.RoomTypeName</option>
                }
            </InputSelect>
        </div>

        <div class="col-auto">
            <select class="form-select" value="@statusString" @onchange="OnStatusStringChanged">
                <option value="">All Status</option>
                <option value="true">Available</option>
                <option value="false">Occupied</option>
            </select>
        </div>

        <div class="col-auto">
            <button type="button" class="btn btn-secondary" @onclick="ResetFilters">Show All</button>
        </div>
    </div>
</div>

<div class="d-flex justify-content-end mb-3">
    <button class="btn btn-outline-danger btn-sm me-2"
            data-bs-toggle="modal" data-bs-target="#addRoomModal">
        <i class="bi bi-plus"></i> Add Room
    </button>
</div>

<!-- ADD‑ROOM MODAL -->
<div class="modal fade" id="addRoomModal" tabindex="-1" aria-labelledby="addRoomModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add New Room</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <EditForm Model="@_model" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label class="form-label">Room Number</label>
                        <InputText class="form-control" @bind-Value="_model.RoomNo" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Room Status</label>
                        <InputSelect TValue="string" class="form-select" @bind-Value="_model.RoomStatus" required>
                            <option value="">Choose…</option>
                            <option value="Available">Available</option>
                            <option value="Occupied">Occupied</option>
                        </InputSelect>
                    </div>

                    <div class="col-12 mb-3">
                        <label class="form-label">Room Type</label>
                        <InputSelect TValue="Guid" class="form-select" @bind-Value="_model.RoomTypeId" required>
                            <option value="">Choose One</option>
                            @foreach (var rt in roomTypes)
                            {
                                <option value="@rt.RoomTypeId">@rt.RoomTypeName</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Guest Limit</label>
                        <InputNumber class="form-control" @bind-Value="_model.GuestLimit" required />
                    </div>

                    <div class="mb-3 form-check">
                        <InputCheckbox class="form-check-input" id="isFeatured" @bind-Value="_model.IsFeatured" />
                        <label class="form-check-label" for="isFeatured">Feature</label>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger" data-bs-dismiss="modal">Save</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

<!-- ROOM TABLE -->
<table class="table table-sm table-bordered align-middle">
    <thead class="table-danger">
        <tr>
            <th>Room No</th>
            <th>Room Status</th>
            <th>Guest Limit</th>
            <th class="d-none">RoomType‑ID</th>
            <th>Feature</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var room in PaginatedRooms())
        {
            <tr class="text-center justify-content-center">
                <td>@room.roomNo</td>
                <td class="text-center">@(room.roomStatus ? "Available" : "Occupied")</td>
                <td>@room.guestlimit</td>
                <td class="d-none">@room.roomTypeId</td>
                <td class="text-center">
                    <button class="btn btn-link text-warning p-0"
                            title="Toggle featured"
                            @onclick="() => ToggleFeatureAsync(room)"
                            disabled="@room.IsBusy">
                        @(room.isFeatured ? "★" : "☆")
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- PAGINATION -->
<div class="d-flex justify-content-center my-3">
    <button class="btn btn-outline-danger btn-sm me-2" @onclick="PreviousPage" disabled="@(!CanGoPrevious)">Previous</button>
    <span>Page @currentPage of @totalPages</span>
    <button class="btn btn-outline-danger btn-sm ms-2" @onclick="NextPage" disabled="@(!CanGoNext)">Next</button>
</div>


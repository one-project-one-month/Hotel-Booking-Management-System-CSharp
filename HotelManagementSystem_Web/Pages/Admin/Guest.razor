@page "/admin/guest"
@inject IJSRuntime JS
@using HotelManagementSystem_Web.Layout.AdminLayout
@using System.ComponentModel.DataAnnotations
@layout AdminLayout
@inject HttpClient _httpClient

<h3 class="text-center mb-4" style="color: #e60000;">Guests Management</h3>

<!-- Search box -->
<div class="d-flex justify-content-center mb-4">
    <form class="d-flex align-items-center w-75" @onsubmit="HandleFilter">
        <!-- search + × -->
        <div class="input-group flex-grow-1 me-2">
            <input type="text"
            class="form-control"
            placeholder="Search by name, phone, email, or NRC…"
            @bind="SearchTerm"
            @bind:event="oninput" />

            @if (!string.IsNullOrWhiteSpace(SearchTerm))
            {
                <button type="button"
                class="btn btn-outline-secondary"
                @onclick="ClearSearch">
                    &times;
                </button>
            }
        </div>

        <!-- filter button -->
        <button type="submit" class="btn btn-danger btn-sm">
            Filter
        </button>
    </form>
</div>


<!-- Guest Table -->
<table class="table table-bordered table-hover align-middle">
    <thead class="table-danger">
        <tr>
            <td class="d-none">GuestId</td>
            <td>Name</td>
            <td>Nrc</td>
            <td>Email</td>
            <td>PhoneNo</td>
            <td class="d-none">UserId</td>
            <td>CreatedAt</td>
        </tr>
    </thead>
    <tbody>

        @if (filterguestList.Count == 0 && guestList.Count == 0)
        {
            <tr><td colspan="8" class="text-center">Loading…</td></tr>
        }

        @foreach (var guest in filterguestList   // not guestList
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize))
        {
            <tr>
                <td class ="d-none">@guest.guestId</td>
                <td>@guest.name</td>
                <td>@guest.nrc</td>
                <td>@guest.email</td>
                <td>@guest.phoneNo</td>
                <td class="d-none">@(guest.userId?.ToString() ?? "N/A")</td>
                <td>@guest.createdAt</td>
            </tr>
        }
    </tbody>
</table>

<!-- Pagination Controls -->
<div class="d-flex justify-content-center my-3">
    <button class="btn btn-outline-danger btn-sm me-2" @onclick="PreviousPage"
            disabled="@(!CanGoPrevious)">
        Previous
    </button>
    <span>Page @currentPage of @totalPages</span>
    <button class="btn btn-outline-danger btn-sm ms-2" @onclick="NextPage" disabled="@(!CanGoNext)">Next</button>
</div>

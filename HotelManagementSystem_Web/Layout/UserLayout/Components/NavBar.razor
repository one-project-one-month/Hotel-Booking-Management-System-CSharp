@using HotelManagementSystem_Web.DevCode
@using HotelManagementSystem_Web.Models.Room
@using HotelManagementSystem_Web.Pages.User
@using Newtonsoft.Json
@using static HotelManagementSystem_Web.Models.Room.SearchRoomResponseModel
@inject HttpClient _httpClient;
@inject SearchRoomState _state;
@inject GetRoomTypeNamesService _roomTypeService;

@code {
    public List<RoomTypeNameModel> roomList = new List<RoomTypeNameModel>();


    protected override async Task OnInitializedAsync()
    {

        await GetRoomTypes();
    }


    public async Task GetRoomTypes()
    {
        roomList = await _roomTypeService.GetRoomTypeNames();
    }

}


@code {
    public async Task SearchRooms()
    {
        var response = await _httpClient.PostAsJsonAsync("/api/SearchRoom/SearchRoom", _state.SharedStateRequestModel);

        Console.WriteLine("Outside Post ");
        if (response.IsSuccessStatusCode)
        {
            Console.WriteLine("Post Success");
            var jsonString = await response.Content.ReadAsStringAsync();

            var jsonify = await response.Content.ReadFromJsonAsync<SearchRoomResponse>();

            foreach (var item in jsonify.SearchedRoomList)
            {
                Console.WriteLine(item.RoomTypeName);
            }

            _state.SharedStateResponseModel = jsonify!;

            _state.NotifyStateChanged();
        }
    }
}




